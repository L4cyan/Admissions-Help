# ── Site ──────────────────────────────────────────────────────────────
# Public URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://adzu-ask.vercel.app

# ── Admin ─────────────────────────────────────────────────────────────
# Passcode for /admin. Change this before deploying.
ADMIN_PASSCODE=change-me-please

# ── AI providers ──────────────────────────────────────────────────────
# The app works with no keys: it falls back to Pollinations' free tier,
# then to quoted notes. Free models are shared and rate-limited, so for a
# public deployment add ONE free key below (Gemini is the fastest).
#
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter (free models supported): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Any OpenAI-compatible endpoint
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: local Ollama for development or a self-hosted desk.
# Leave OLLAMA_BASE_URL empty on Vercel.
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:4b

# Keyless fallback. Set FREE_AI=off to disable Pollinations entirely.
FREE_AI=on
POLLINATIONS_MODEL=openai-fast

# ── Persistence (optional on Vercel) ─────────────────────────────────
# Without this, uploaded documents are saved locally in data/kb.json.
# On Vercel, connect a Blob store and set BLOB_READ_WRITE_TOKEN so
# admin uploads survive deployments.
BLOB_READ_WRITE_TOKEN=

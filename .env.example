# ── Site ──────────────────────────────────────────────────────────────
# Public URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://adzu-ask.vercel.app

# ── Admin ─────────────────────────────────────────────────────────────
# Passcode for /admin. Change this before deploying.
ADMIN_PASSCODE=change-me-please

# ── AI provider (pick one; the app falls back to quoted-notes mode) ───
# OpenRouter (free models supported)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Any OpenAI-compatible endpoint
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Persistence (optional on Vercel) ─────────────────────────────────
# Without this, uploaded documents are saved locally in data/kb.json.
# On Vercel, connect a Blob store and set BLOB_READ_WRITE_TOKEN so
# admin uploads survive deployments.
BLOB_READ_WRITE_TOKEN=
